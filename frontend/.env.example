# URL of the deployed backend (no trailing slash).
# Locally this can be omitted - App.jsx falls back to http://127.0.0.1:8000.
# On Render, set this as a build-time environment variable on the
# static site (Vite bakes VITE_* vars in at build time, so it must be
# set BEFORE the build runs, not just at runtime).
VITE_API_BASE_URL=https://your-backend-service.onrender.com
